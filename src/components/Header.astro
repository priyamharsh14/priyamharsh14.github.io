---
import CommandMenu from "./CommandMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { isCurrent, nav } from "../data/nav";
import { profile } from "../data/profile";

const pathname = Astro.url.pathname;
const primary = nav.filter((item) => item.primary);
---

<header class="border-b border-line pb-4">
  <div class="flex items-center justify-between gap-3">
    <a href="/" class="font-medium text-fg no-underline hover:text-accent">{profile.name}</a>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <CommandMenu />
    </div>
  </div>
  <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Primary">
    {
      primary.map((item) => (
        <a class="nav-link" href={item.href} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
