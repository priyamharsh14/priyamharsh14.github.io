---
import { isCurrent, nav } from "../data/nav";
import { profile } from "../data/profile";

const pathname = Astro.url.pathname;
const secondary = nav.filter((item) => !item.primary && item.href !== "/");
const year = new Date().getUTCFullYear();
---

<footer class="mt-16 border-t border-line py-8 text-sm text-muted">
  <p>
    <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
  </p>
  <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-2" aria-label="More">
    {
      secondary.map((item) => (
        <a class="nav-link" href={item.href} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a class="nav-link" href="/rss.xml">RSS</a>
  </nav>
  <p class="mt-4">© {year} {profile.name}</p>
</footer>
