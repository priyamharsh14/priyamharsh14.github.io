<Base title="Uses" description="Tools Priyam Harsh uses. Mac and Cursor are filled in. The rest is still blank.">
  <h1 class="text-3xl font-semibold tracking-tight">Uses</h1>
  <p class="mt-4 leading-relaxed text-muted">
    A <a class="link" href="https://uses.tech">uses</a> page. Only the two facts below are filled in.
  </p>
  <dl class="mt-8 divide-y divide-line border-y border-line">
    <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
      <dt class="font-mono text-sm text-muted">Computer</dt>
      <dd>Mac</dd>
    </div>
    <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
      <dt class="font-mono text-sm text-muted">Editor</dt>
      <dd>Cursor</dd>
    </div>
    <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
      <dt class="font-mono text-sm text-muted">Terminal</dt>
      <dd class="todo my-0">TODO: terminal, shell, and font.</dd>
    </div>
    <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
      <dt class="font-mono text-sm text-muted">Browser</dt>
      <dd class="todo my-0">TODO: browser.</dd>
    </div>
    <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
      <dt class="font-mono text-sm text-muted">Notes</dt>
      <dd class="todo my-0">TODO: notes app.</dd>
    </div>
    <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
      <dt class="font-mono text-sm text-muted">Other</dt>
      <dd class="todo my-0">TODO: anything else you actually use and want to list.</dd>
    </div>
  </dl>
</Base>
