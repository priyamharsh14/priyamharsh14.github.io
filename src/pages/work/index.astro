---
import Base from "../../layouts/Base.astro";
import { earlierRoles, education, experience, howWeBuiltIt, stack } from "../../data/profile";
---

<Base title="Work" description="Lead Software Developer at Travvir, earlier roles, and education.">
  <h1 class="text-3xl font-semibold tracking-tight">Work</h1>
  <p class="mt-4 leading-relaxed text-muted">Roles, then a short stack.</p>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="text-xl font-semibold tracking-tight">Experience</h2>
    <article class="mt-6">
      <h3 class="text-lg font-medium">
        <a class="link" href={experience.url}>{experience.organization}</a>
      </h3>
      <ul class="mt-4 grid gap-3">
        {
          experience.roles.map((role) => (
            <li>
              <p class="font-medium">{role.title}</p>
              <p class="font-mono text-sm text-muted">{role.dates}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 leading-relaxed">{experience.summary}</p>
      <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed">
        {experience.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </article>

    {
      earlierRoles.map((role) => (
        <article class="mt-10">
          <h3 class="text-lg font-medium">
            {role.organization ? `${role.title}, ${role.organization}` : role.title}
          </h3>
          {role.dates && <p class="mt-1 font-mono text-sm text-muted">{role.dates}</p>}
          {role.summary && <p class="mt-3 leading-relaxed">{role.summary}</p>}
        </article>
      ))
    }
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="education-heading">
    <h2 id="education-heading" class="text-xl font-semibold tracking-tight">Education</h2>
    <ul class="mt-4 grid gap-4">
      {
        education.map((item) => (
          <li>
            <p class="font-medium">{item.title}</p>
            <p class="mt-1 font-mono text-sm text-muted">{item.dates}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-xl font-semibold tracking-tight">How we built it</h2>
    <p class="mt-4 leading-relaxed text-muted">
      Decisions and habits. Nothing here is a description of the technology, and none of it is confirmed copy yet.
    </p>
    <ul class="mt-4 grid list-none gap-3 p-0">
      {
        howWeBuiltIt.map((item) =>
          item.kind === "draft" ? (
            <li class="todo">TODO: Priyam — draft. Confirm or rewrite. {item.text}</li>
          ) : (
            <li class="todo">TODO: Priyam — write this in your own words. Prompt: {item.prompt}</li>
          ),
        )
      }
    </ul>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="text-xl font-semibold tracking-tight">Skills</h2>
    <p class="mt-4 leading-relaxed">{stack.join(", ")}</p>
  </section>
</Base>
