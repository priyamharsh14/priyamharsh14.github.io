---
import Capabilities from "../../components/Capabilities.astro";
import Base from "../../layouts/Base.astro";
import { earlierWork, experience, lessons } from "../../data/profile";
---

<Base title="Work" description="Travvir, earlier freelance work, and the kinds of systems Priyam Harsh works on.">
  <h1 class="text-3xl font-semibold tracking-tight">Work</h1>
  <p class="mt-4 leading-relaxed text-muted">Employment first, then the kinds of systems I work on.</p>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="text-xl font-semibold tracking-tight">Experience</h2>
    <article class="mt-6">
      <h3 class="text-lg font-medium">
        <a class="link" href={experience.url}>{experience.organization}</a>
      </h3>
      <p class="mt-1 font-mono text-sm text-muted">{experience.location}</p>
      <ul class="mt-4 grid gap-3">
        {
          experience.roles.map((role) => (
            <li>
              <p class="font-medium">{role.title}</p>
              <p class="font-mono text-sm text-muted">{role.dates}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 leading-relaxed">{experience.summary}</p>
      <p class="mt-3 leading-relaxed">
        <span class="font-medium">What I own.</span> {experience.owns}
      </p>
    </article>

    <article class="mt-10">
      <h3 class="text-lg font-medium">{earlierWork.title}</h3>
      <p class="mt-1 font-mono text-sm text-muted">{earlierWork.dates}</p>
      <p class="mt-3 leading-relaxed">{earlierWork.summary}</p>
      <p class="todo">
        TODO: add company or client names here if you want them public. None are listed on purpose.
      </p>
    </article>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="lessons-heading">
    <h2 id="lessons-heading" class="text-xl font-semibold tracking-tight">Lessons from building</h2>
    <p class="todo">
      TODO: Priyam — draft. Confirm or rewrite each lesson in <code>src/data/profile.ts</code>. These are general
      engineering notes, not a description of Travvir.
    </p>
    <ol class="mt-4 grid list-decimal gap-4 pl-5 leading-relaxed">
      {lessons.map((lesson) => <li>{lesson}</li>)}
    </ol>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="capabilities-heading">
    <h2 id="capabilities-heading" class="text-xl font-semibold tracking-tight">Skills</h2>
    <Capabilities />
  </section>
</Base>
