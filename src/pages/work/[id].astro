---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { findRepo, formatStars, loadPublicRepos } from "../../lib/github";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { repos } = await loadPublicRepos();
const repo = findRepo(repos, entry.data.repo);
const bits = [repo?.language, repo?.archived ? "Archived" : null, formatStars(repo?.stars ?? null)].filter(
  (bit): bit is string => Boolean(bit),
);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <p class="font-mono text-sm text-muted">Project</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{entry.data.title}</h1>
    <p class="mt-3 font-mono text-sm text-muted">{bits.join(" · ")}</p>
    {
      repo && (
        <p class="mt-3">
          <a class="link" href={repo.url}>
            View on GitHub
          </a>
        </p>
      )
    }
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</Base>
