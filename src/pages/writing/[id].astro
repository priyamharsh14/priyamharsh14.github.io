---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Giscus from "../../components/Giscus.astro";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => import.meta.env.DEV || data.draft !== true);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} noindex={post.data.draft}>
  <article>
    {
      post.data.draft && (
        <p class="todo">
          TODO: draft. This page is not part of the production build. Set <code>draft: false</code> after you edit
          it.
        </p>
      )
    }
    <p class="font-mono text-sm text-muted">{formatDate(post.data.pubDate)}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{post.data.title}</h1>
    {
      post.data.tags.length > 0 && (
        <p class="mt-3 font-mono text-xs text-muted">{post.data.tags.join(" · ")}</p>
      )
    }
    <div class="prose mt-8">
      <Content />
    </div>
    <Giscus />
  </article>
</Base>
