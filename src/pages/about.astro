---
import Base from "../layouts/Base.astro";
import { education, profile, stack, timeline } from "../data/profile";
---

<Base
  title="About"
  description="Priyam Harsh. Lead Software Developer in New Delhi. BCA, St. Xavier's College, Ranchi."
>
  <h1 class="text-3xl font-semibold tracking-tight">About</h1>
  <div class="mt-4 space-y-4 leading-relaxed">
    <p>
      I'm {profile.name}, a Lead Software Developer in {profile.location}. I build backend systems, cloud
      infrastructure, and mobile apps. Before that I spent time on security research: reverse engineering, packet
      analysis, and responsible disclosure.
    </p>
    <p>
      <a class="link" href="/security/">Security</a> has the short version of that past.{" "}
      <a class="link" href="/work/">Work</a> has the employment note and what I work on.
    </p>
  </div>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="text-xl font-semibold tracking-tight">Timeline</h2>
    <ol class="mt-6 grid gap-6">
      {
        timeline.map((item) => (
          <li>
            {item.dates && <p class="font-mono text-sm text-muted">{item.dates}</p>}
            <p class="mt-1 font-medium">{item.title}</p>
            {item.detail && <p class="mt-1 leading-relaxed text-muted">{item.detail}</p>}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="text-xl font-semibold tracking-tight">Skills</h2>
    <p class="mt-4 leading-relaxed">{stack.join(", ")}</p>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="education-heading">
    <h2 id="education-heading" class="text-xl font-semibold tracking-tight">Education</h2>
    <ul class="mt-4 grid gap-4">
      {
        education.map((item) => (
          <li>
            <p class="font-medium">{item.title}</p>
            <p class="mt-1 font-mono text-sm text-muted">{item.dates}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 border-t border-line pt-8" aria-labelledby="resume-heading">
    <h2 id="resume-heading" class="text-xl font-semibold tracking-tight">Resume</h2>
    <p class="todo">
      TODO: drop a PDF at <code>public/resume.pdf</code>. There is no link yet, so the site does not point at a
      missing file.
    </p>
  </section>
</Base>
